# ─────────────────────────────────────────────────────────────
#  WhatsApp Manager — environment configuration
#  Copy to `.env` and adjust. Nothing here is committed.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────
# Either set DATABASE_URL, or the discrete PG* vars below.
# DATABASE_URL takes precedence when present.
# DATABASE_URL=postgres://postgres:postgres@localhost:42016/whatsapp_manager

PGHOST=localhost
PGPORT=42016
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=whatsapp_manager

# ── WhatsApp ─────────────────────────────────────────────────
# Identifier for the persisted session folder (LocalAuth).
WHATSAPP_CLIENT_ID=personal-monitor
# Where the WhatsApp Web session is stored so you don't rescan every restart.
SESSION_DATA_PATH=./.wwebjs_auth
# Set only if you want to use a system Chromium instead of the bundled one
# (the Docker image sets this to /usr/bin/chromium automatically).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Monitor group chats too? Off by default — only 1:1 chats are processed.
MONITOR_GROUPS=false

# WhatsApp Web build to load. whatsapp-web.js pins an OLD build that WhatsApp
# now rejects at link time ("Couldn't link device, try again later"), so we
# load a current one from https://github.com/wppconnect-team/wa-version.
# If linking starts failing again later, pick a newer file from that repo's
# /html folder and update this value (drop the ".html").
WA_WEB_VERSION=2.3000.1042470511-alpha
# Or override the whole URL (must return the WA Web page HTML):
# WA_WEB_VERSION_REMOTE_PATH=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/2.3000.1042470511-alpha.html

# ── Safety ───────────────────────────────────────────────────
# Master switch for ANY outbound sending. OFF by default.
ENABLE_OUTBOUND=false
# Rate limit applied to the (future) outbound endpoint.
OUTBOUND_RATE_LIMIT_WINDOW_MS=60000
OUTBOUND_RATE_LIMIT_MAX=10

# ── API auth (optional) ──────────────────────────────────────
# If set, every endpoint except /health requires header `x-api-key`
# (or `?api_key=` query param). Leave empty to disable for local use.
API_KEY=

# ── Encrypted credentials store ──────────────────────────────
# Master key that encrypts provider API keys at rest (AES-256-GCM) in Postgres.
# Generate one with:  openssl rand -base64 32
# If unset, the credentials store is disabled and the plaintext *_API_KEY vars
# below are used directly (bootstrap/dev only). Losing this key makes stored
# credentials unrecoverable — you'd just re-enter them.
CREDENTIALS_ENCRYPTION_KEY=

# ── AI providers ─────────────────────────────────────────────
# Preferred: store these via PUT /credentials/openai and /credentials/deepseek
# (encrypted). The env vars here are an optional fallback when the encrypted
# store is disabled or a key isn't set there yet.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model ids. TRANSLATION_MODEL is the exact DeepSeek API model string.
# deepseek-chat is deprecated 2026-07-24 (no grace period); deepseek-v4-flash
# is its direct non-thinking-mode replacement, same cost tier.
TRANSCRIPTION_MODEL=gpt-4o-transcribe
TRANSLATION_MODEL=deepseek-v4-flash
TARGET_LANGUAGE=en

# ── Media archival ───────────────────────────────────────────
# Where downloaded attachments (images/audio/video/docs) are stored on disk.
MEDIA_STORAGE_PATH=./media
# Skip attachments larger than this many bytes (0 = unlimited).
MEDIA_MAX_BYTES=0

# ── Transcription worker ─────────────────────────────────────
# Auto-transcribe whitelisted voice notes/audio via OpenAI. Needs an OpenAI key.
ENABLE_TRANSCRIPTION=false
TRANSCRIPTION_POLL_INTERVAL_MS=15000
TRANSCRIPTION_BATCH=5

# ── History backfill ─────────────────────────────────────────
# Per-chat cap when pulling history via POST /backfill (0 = all available).
BACKFILL_LIMIT_PER_CHAT=1000

# ── API cost tracking ─────────────────────────────────────────
# Rates (USD), verified against provider docs as of 2026-07-02 — providers
# change pricing without notice, so re-verify periodically. A rate change
# only affects calls recorded after the change.
OPENAI_TRANSCRIBE_COST_PER_MINUTE=0.006
# DeepSeek input rate is the standard (cache-miss) price; cache-hit tokens
# aren't tracked separately, so this is a conservative upper-bound estimate.
DEEPSEEK_INPUT_COST_PER_1M_TOKENS=0.14
DEEPSEEK_OUTPUT_COST_PER_1M_TOKENS=0.28
